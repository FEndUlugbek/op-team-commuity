# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # faqat login uchun ishlatiladi
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # MAXFIY! Faqat serverda, hech qachon frontendga qo'ymang

# Admin panelga kira oladigan email(lar) — vergul bilan ajrating
ADMIN_EMAILS=siz@example.com

# IXTIYORIY: yangi ariza kelganda Discord'ga xabar. Arizalar baribir saytda (Supabase) saqlanadi.
# YANGI webhook yarating — eskisi ochiq qolib ketgan. Kerak bo'lmasa bo'sh qoldiring.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Server
PORT=3000
NODE_ENV=development
# Render/Railway/Nginx orqasida bo'lsa 1 qiling (rate limit to'g'ri IP ko'rishi uchun)
TRUST_PROXY=0
